# Copiez ce fichier en .env à la racine du projet et adaptez les valeurs.
# Jamais de secret dans le front : tout ce qui est ici n'est lu que par le backend.

# Sécurité — OBLIGATOIRE en production : longue chaîne aléatoire (ex. `openssl rand -hex 32`)
SECRET_KEY=change-me-in-production-please
ENVIRONMENT=development
SITE_URL=http://localhost:8000

# Compte administrateur créé au premier démarrage (changez le mot de passe ensuite depuis l'admin)
ADMIN_EMAIL=admin@tharros-studio.fr
ADMIN_PASSWORD=tharros-admin

# Notifications par e-mail : destinataire, puis UN service d'envoi.
MAIL_TO=tharrs.studio@gmail.com
MAIL_FROM="Tharros <tharrs.studio@gmail.com>"
# Option 1 — Gmail (mot de passe d'application : https://myaccount.google.com/apppasswords, 2FA requise)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tharrs.studio@gmail.com
SMTP_PASSWORD=
# Option 2 — Resend (https://resend.com) : laissez SMTP_HOST vide et renseignez la clé
RESEND_API_KEY=

# Origines autorisées à appeler l'API en développement (Vite)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
